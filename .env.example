# ---------------------------------------------------------------
# Panel login. Single user. Change both values before deploying.
# ---------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Secret used to sign the session cookie. At least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-of-32-chars-or-more

# ---------------------------------------------------------------
# Panel
# ---------------------------------------------------------------
PORT=3000
# Where the panel sees the Minecraft data folder (the volume mounted in the panel container).
DATA_DIR=/data

# ---------------------------------------------------------------
# Minecraft server container
# ---------------------------------------------------------------
# Address players type in Minecraft. Shown in the panel. Example: mc.example.com
MC_PUBLIC_ADDRESS=
# Host port published for Minecraft (Java Edition uses 25565 by default).
MC_PORT=25565
# Memory given to the Java heap. Examples: 2G, 4G, 1536M.
MC_MEMORY=2G
MC_IMAGE=itzg/minecraft-server
MC_CONTAINER_NAME=maicra-minecraft
# Docker volume name or host path mounted at /data inside the Minecraft container.
# Leave empty to detect it automatically from the panel's own container mount of DATA_DIR.
MC_DATA_MOUNT=
# Docker network the Minecraft container joins. The panel creates it when missing. A user defined
# network gives the container Docker's embedded DNS; the default "bridge" network can fail to
# resolve names on some hosts.
MC_NETWORK=maicra
# User and group the Minecraft process runs as. Files written by the panel get this owner.
MC_UID=1000
MC_GID=1000
TZ=UTC

# "docker" controls a real container. "fake" simulates a server for UI development.
RUNTIME=docker
# auto = Secure cookie only when the request arrives over HTTPS.
COOKIE_SECURE=auto
